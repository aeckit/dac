exports[`Playground Baseline Snapshot Regression Tests > renders DEMO-1.json sheet with referenced viewports consistently 1`] = `
"
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 24" width="100%" height="100%">
      
    <defs>
      <pattern id="concrete-hatch" width="60" height="60" patternUnits="userSpaceOnUse">
        <circle cx="10" cy="15" r="1" fill="#475569"/>
        <circle cx="45" cy="20" r="1.5" fill="#475569"/>
        <circle cx="20" cy="45" r="1" fill="#475569"/>
        <circle cx="50" cy="50" r="1" fill="#475569"/>
        <path d="M 5,35 L 12,32 L 8,40 Z" class="concrete-aggregate" fill="none" stroke="#64748b" stroke-width="1.5" />
        <path d="M 35,10 L 42,15 L 33,18 Z" class="concrete-aggregate" fill="none" stroke="#64748b" stroke-width="1.5" />
        <path d="M 40,40 L 48,35 L 45,45 Z" class="concrete-aggregate" fill="none" stroke="#64748b" stroke-width="1.5" />
      </pattern>
      <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 2 L 10 5 L 0 8 z" class="dimension-arrow" fill="#06b6d4" />
      </marker>
      <marker id="origin-arrow-x" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 2 L 10 5 L 0 8 z" fill="#f43f5e" />
      </marker>
      <marker id="origin-arrow-y" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 2 L 10 5 L 0 8 z" fill="#38bdf8" />
      </marker>
      <filter id="hover-text-bg" x="-2%" y="-5%" width="104%" height="110%">
        <feFlood flood-color="rgba(148, 163, 184, 0.2)" result="bg" />
        <feMerge>
          <feMergeNode in="bg" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
  
      <rect width="36" height="24" class="blueprint-bg" />
      <g id="sheet-content">
        
<!-- Title Block -->
<g id="title-block-layer" transform="translate(0, 0)">
      <g data-component-id="shape_0" data-component-type="Rectangle" class="">
        
    <g>
      <rect x="0.25" y="0.25" width="35.5" height="23.5" fill="none" stroke="transparent" stroke-width="0.5" class="cad-hit-area" />
      <rect x="0.25" y="0.25" width="35.5" height="23.5" fill="none" stroke="#1e293b" stroke-width="0.05555555555555555" stroke-linejoin="round" />
      
    </g>
  
      </g>
    

      <g data-component-id="shape_1" data-component-type="Rectangle" class="">
        
    <g>
      <rect x="31" y="0.25" width="4.75" height="23.5" fill="none" stroke="transparent" stroke-width="0.5" class="cad-hit-area" />
      <rect x="31" y="0.25" width="4.75" height="23.5" fill="none" stroke="#334155" stroke-width="0.027777777777777776" stroke-linejoin="round" />
      
    </g>
  
      </g>
    

      <g data-component-id="shape_2" data-component-type="Text" class="">
        <text x="31.5" y="1" font-size="0.2222222222222222" fill="#64748b" class="cad-text" dominant-baseline="auto">PROJECT:</text>
      </g>
    

      <g data-component-id="shape_3" data-component-type="Text" class="">
        <text x="31.5" y="1.5" font-size="0.3333333333333333" fill="#e2e8f0" class="cad-text" dominant-baseline="auto">{parameters.projectName}</text>
      </g>
    

      <g data-component-id="shape_4" data-component-type="Text" class="">
        <text x="31.5" y="4" font-size="0.2222222222222222" fill="#64748b" class="cad-text" dominant-baseline="auto">ADDRESS:</text>
      </g>
    

      <g data-component-id="shape_5" data-component-type="Text" class="">
        <text x="31.5" y="2.5" font-size="0.19444444444444445" fill="#64748b" class="cad-text" dominant-baseline="auto">N/A</text>
      </g>
    

      <g data-component-id="shape_6" data-component-type="Line" class="">
        <line x1="31" y1="23.75" x2="31" y2="0.25" stroke="transparent" stroke-width="0.5" class="cad-hit-area" />
<line x1="31" y1="23.75" x2="31" y2="0.25" stroke="#334155" stroke-width="0.027777777777777776"  stroke-linecap="round" />
      </g>
    

