<text x="0.375" y="18.5625" font-size="0.375" fill="#f1f5f9" font-family="monospace" text-anchor="middle" dominant-baseline="central">2</text>
<line x1="0.75" y1="18.5625" x2="19.5" y2="18.5625" stroke="#f1f5f9" stroke-width="0.03125" />
<text x="0.9" y="18.4125" font-size="0.30000000000000004" fill="#f1f5f9" font-family="monospace" font-weight="bold" dominant-baseline="alphabetic">JSON EDITOR GUIDE</text>
<text x="0.9" y="18.7125" font-size="0.1875" fill="#94a3b8" font-family="monospace" dominant-baseline="hanging">0.6666666666666666</text>

        <rect x="0" y="-1.5" width="19.5" height="19.5" fill="transparent" stroke="#475569" stroke-width="0.020833333333333332" stroke-dasharray="0.1, 0.1" pointer-events="all" />
      </g>
    
