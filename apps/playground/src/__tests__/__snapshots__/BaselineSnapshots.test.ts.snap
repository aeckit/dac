      </g>
    

      <g data-component-id="shape_8" data-component-type="Text" class="">
        <text x="32" y="21" font-size="0.6666666666666666" fill="#38bdf8" class="cad-text" dominant-baseline="auto">{parameters.sheetNumber}</text>
      </g>
    </g>
<!-- Viewports -->

      <defs><clipPath id="clip-img-STATIC"><rect x="0" y="-1.5" width="22.5" height="19.5" /></clipPath></defs>
      <g data-component-id="vp_welcome" data-component-type="CAD::Viewport" class="interactive-component pointer-cursor" data-viewport-id="viewport-welcome-detail.json" transform="translate(1, 2) scale(0.6666666666666666)">
        <g clip-path="url(#clip-img-STATIC)">
          <g transform="translate(0, 0)">
            
      <g data-component-id="shape_0" data-component-type="Text" class="">
        <text x="1" y="2" font-size="1" fill="#f1f5f9" class="cad-text" dominant-baseline="auto">Welcome to AECKit Playground!</text>
      </g>
    

      <g data-component-id="shape_1" data-component-type="Text" class="">
        <text x="1" y="4" font-size="0.4166666666666667" fill="#cbd5e1" class="cad-text" dominant-baseline="auto"><tspan x="1" dy="0em">This playground lets you explore the AECKit CAD</tspan><tspan x="1" dy="1.2em">framework directly in your browser.</tspan><tspan x="1" dy="1.2em"></tspan><tspan x="1" dy="1.2em">1. Use the left sidebar to manage Projects, Sheets, and Details.</tspan><tspan x="1" dy="1.2em">2. Projects contain Sheets. Sheets contain Viewports.</tspan><tspan x="1" dy="1.2em">3. Viewports render Details at a specific scale.</tspan></text>
      </g>
    

      <g data-component-id="border" data-component-type="Rectangle" class="">
        
    <g>
      <rect x="0" y="0" width="20" height="18" fill="none" stroke="transparent" stroke-width="0.5" class="cad-hit-area" />
      <rect x="0" y="0" width="20" height="18" fill="none" stroke="#3b82f6" stroke-width="0.041666666666666664" stroke-linejoin="round" />
      
    </g>
  
      </g>
    
          </g>
        </g>
        <circle cx="0.375" cy="18.5625" r="0.375" fill="none" stroke="#f1f5f9" stroke-width="0.03125" />
<text x="0.375" y="18.5625" font-size="0.375" fill="#f1f5f9" font-family="monospace" text-anchor="middle" dominant-baseline="central">1</text>
<line x1="0.75" y1="18.5625" x2="22.5" y2="18.5625" stroke="#f1f5f9" stroke-width="0.03125" />
<text x="0.9" y="18.4125" font-size="0.30000000000000004" fill="#f1f5f9" font-family="monospace" font-weight="bold" dominant-baseline="alphabetic">WELCOME DETAIL</text>
<text x="0.9" y="18.7125" font-size="0.1875" fill="#94a3b8" font-family="monospace" dominant-baseline="hanging">0.6666666666666666</text>

        <rect x="0" y="-1.5" width="22.5" height="19.5" fill="transparent" stroke="#475569" stroke-width="0.020833333333333332" stroke-dasharray="0.1, 0.1" pointer-events="all" />
      </g>
    
      <defs><clipPath id="clip-img-STATIC"><rect x="0" y="-1.5" width="19.5" height="19.5" /></clipPath></defs>
      <g data-component-id="vp_json" data-component-type="CAD::Viewport" class="interactive-component pointer-cursor" data-viewport-id="viewport-json-editor-guide.json" transform="translate(17, 2) scale(0.6666666666666666)">
        <g clip-path="url(#clip-img-STATIC)">
          <g transform="translate(0, 0)">
            
      <g data-component-id="shape_0" data-component-type="Text" class="">
        <text x="1" y="2" font-size="0.75" fill="#38bdf8" class="cad-text" dominant-baseline="auto">JSON Mode & Editing</text>
      </g>
    

      <g data-component-id="shape_1" data-component-type="Text" class="">
        <text x="1" y="4" font-size="0.3333333333333333" fill="#94a3b8" class="cad-text" dominant-baseline="auto"><tspan x="1" dy="0em">Click on any element in the canvas to select it.</tspan><tspan x="1" dy="1.2em"></tspan><tspan x="1" dy="1.2em">Then, open the Properties pane on the right and</tspan><tspan x="1" dy="1.2em">click the 'JSON' toggle to view its raw data.</tspan><tspan x="1" dy="1.2em"></tspan><tspan x="1" dy="1.2em">You can edit the JSON directly (e.g., change the</tspan><tspan x="1" dy="1.2em">'color' or 'width' property) and watch the canvas</tspan><tspan x="1" dy="1.2em">update in real-time!</tspan></text>
      </g>
    

      <g data-component-id="border" data-component-type="Rectangle" class="">
        
    <g>
