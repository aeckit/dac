{
  "name": "@aeckit/dac-renderer-svg",
  "version": "0.2.0",
  "description": "Pure framework-agnostic SVG rendering engine for Drawing-as-Code Intermediate Representation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aeckit/dac-schema": "^0.3.0",
    "@aeckit/dac-json-solver": "^0.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aeckit/dac.git",
    "directory": "packages/renderer-svg"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
