{
  "name": "@aeckit/dac-solid",
  "version": "0.6.0",
  "description": "SolidJS UI components for Drawing-as-Code",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "dependencies": {
    "@aeckit/dac-json-builder": "^0.3.0",
    "@aeckit/dac-json-solver": "^0.3.1",
    "@aeckit/dac-renderer-svg": "^0.3.0",
    "@aeckit/dac-schema": "^0.4.1",
    "lucide-solid": "^0.378.0"
  },
  "devDependencies": {
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.8.17",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aeckit/dac.git",
    "directory": "packages/dac-solid"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
